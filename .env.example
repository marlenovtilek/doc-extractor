# ==========================================
# Routing Logic
# ==========================================
# Primary / fallback задаются явно как provider::model_id
LLM_MODEL_PRIMARY=gemini::gemini-2.5-flash-lite
LLM_MODEL_FALLBACK=gemini::gemini-2.5-pro

# ==========================================
# Models By Provider
# ==========================================
# Эти модели автоматически показываются в Web UI
GEMINI_MODELS=gemini-2.5-flash-lite|gemini-2.5-pro
GPT_MODELS=gpt-4o-mini
OLLAMA_MODELS=gpt-oss:120b
CEREBRAS_MODELS=llama3.1-8b
VLLM_MODELS=google/gemma-4-31B-it|google/gemma-4-26B-A4B-it|Qwen/Qwen2.5-14B-Instruct
VLM_MODELS=google/gemma-4-31B-it|google/gemma-4-26B-A4B-it|Qwen/Qwen3-VL-8B-Instruct

# ==========================================
# API Keys
# ==========================================
DOC_EXTRACTOR_API_TOKEN=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
VLLM_API_KEY=local-vllm-key
VLM_API_KEY=local-vlm-key

# ==========================================
# Provider Settings
# ==========================================
CEREBRAS_BASE_URL=https://api.cerebras.ai
OLLAMA_BASE_URL=http://host.docker.internal:11434
VLLM_BASE_URL=http://127.0.0.1:7401/v1
VLM_BASE_URL=http://127.0.0.1:7402/v1
GEMINI_TIMEOUT_S=180
OPENAI_TIMEOUT_S=90
CEREBRAS_TIMEOUT_S=60
OLLAMA_TIMEOUT_S=600
VLLM_TIMEOUT_S=300
VLM_TIMEOUT_S=300
VLLM_SUPPORTS_LARGE_CONTEXT=false
VLM_PDF_RENDER_DPI=144
VLM_PAGES_PER_PROMPT=1
VLM_MAX_PAGES=40
INVOICE_VLM_HELPER_MODEL=

# ==========================================
# Extraction Fine-tuning
# ==========================================
INVOICE_CHUNK_SIZE_GEMINI=100000
INVOICE_CHUNK_SIZE_OPENAI=80000
INVOICE_CHUNK_SIZE_OLLAMA=20000
INVOICE_CHUNK_SIZE_CEREBRAS=3500
INVOICE_CHUNK_SIZE_VLLM=10000
INVOICE_VLLM_MAX_WORKERS=2
INVOICE_CHUNK_OVERLAP_DEFAULT=600
INVOICE_CHUNK_OVERLAP_VLLM=0
CHUNK_SIZE_DEFAULT=15000
DEFAULT_CHUNK_MAX_WORKERS=2
LLM_MAX_CHAR_BUFFER=12000
WEB_JOB_MAX_WORKERS=2
WEB_JOB_RETENTION_S=3600
WEB_JOB_MAX_STORED=100
CURRENCY_DB_JSON=[]
