LLM_MODEL_PRIMARY=cerebras
LLM_MODEL_FALLBACK=gemini
MODEL_AUTO_ROUTE=true
MODEL_AUTO_ROUTE_SMALL_DOC=gemini-flash
MODEL_AUTO_ROUTE_LARGE_TABLE=cerebras
MODEL_AUTO_ROUTE_OBJECT_DEFAULT=gemini-flash
AUTO_ROUTE_CHAR_THRESHOLD=12000
AUTO_ROUTE_PIPE_ROW_THRESHOLD=25
WEB_JOB_MAX_WORKERS=2
LLM_MAX_WORKERS_CEREBRAS=1
LLM_MAX_CHAR_BUFFER_CEREBRAS=100000

