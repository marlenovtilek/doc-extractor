# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── Model selection ────────────────────────────────────────────────────────────
# Supported aliases:
#   "cerebras"  → gpt-oss-120b       (direct Cerebras SDK path)
#   "gemini"    → gemini-2.5-flash   (LangExtract)
#   "openai"    → OPENAI_MODEL_DEFAULT
#   "ollama"    → OLLAMA_MODEL_DEFAULT
#
# Explicit provider syntax is also supported:
#   provider::model_id
# Examples:
#   gemini::gemini-2.5-flash
#   openai::gpt-4o-mini
#   ollama::qwen2.5:7b
LLM_MODEL_PRIMARY=cerebras
LLM_MODEL_FALLBACK=gemini

# ── Cerebras cloud — gpt-oss-120b ─────────────────────────────────────────────
CEREBRAS_BASE_URL=https://api.cerebras.ai
CEREBRAS_API_KEY=your_cerebras_api_key_here  # cerebras.ai/openai
LLM_MAX_WORKERS_CEREBRAS=1
LLM_MAX_CHAR_BUFFER_CEREBRAS=100000          # 131K ctx → whole invoice in 1 chunk
CEREBRAS_MAX_RETRIES=3
CEREBRAS_RETRY_BASE_DELAY_S=2.0

# ── Gemini 2.5 Flash — fallback ───────────────────────────────────────────────
LANGEXTRACT_API_KEY=your_gemini_api_key_here  # aistudio.google.com/apikey
LLM_MAX_CHAR_BUFFER=5000
LLM_MAX_WORKERS_GEMINI=5

# ── OpenAI / OpenAI-compatible hosted models via LangExtract ─────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_MODEL_DEFAULT=gpt-4o-mini
LLM_MAX_WORKERS_OPENAI=5

# ── Ollama local or remote runtime via LangExtract ───────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL_DEFAULT=qwen2.5:7b
OLLAMA_TIMEOUT_S=120

# ── Currency database (JSON array) ────────────────────────────────────────────
CURRENCY_DB_JSON=[{"code":"EUR","name":"Euro"},{"code":"USD","name":"US Dollar"},{"code":"RUB","name":"Russian Ruble"},{"code":"CNY","name":"Chinese Yuan"}]
